generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ===============================
// DISTRICT
// ===============================

model District {
  id          String       @id @default(uuid())
  name        String
  state       String

  habitations Habitation[]
  hazards     Hazard[]
  sites       RelocationSite[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}


// ===============================
// HABITATION
// ===============================

model Habitation {
  id                    String   @id @default(uuid())
  name                  String

  districtId            String
  district              District @relation(fields: [districtId], references: [id])

  population            Int
  children              Int      @default(0)
  elderly               Int      @default(0)
  disabled              Int      @default(0)

  povertyIndex          Float    @default(0)
  roadAccessibility     Float    @default(0)
  healthcareAccess      Float    @default(0)

  floodRisk             Float    @default(0)
  landslideRisk         Float    @default(0)
  historicalRisk        Float    @default(0)

  exposure              Float    @default(0)

  riskScore             Float    @default(0)
  riskLevel             String   @default("LOW")

  relocationPriority    String   @default("MONITOR")

  latitude              Float
  longitude             Float

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}


// ===============================
// HAZARD
// ===============================

model Hazard {
  id          String   @id @default(uuid())

  districtId  String
  district    District @relation(fields: [districtId], references: [id])

  type        String
  severity    Float

  latitude    Float?
  longitude   Float?

  createdAt   DateTime @default(now())
}


// ===============================
// DISASTER EVENT
// ===============================

model DisasterEvent {
  id          String   @id @default(uuid())

  type        String
  severity    Float

  eventDate   DateTime

  latitude    Float?
  longitude   Float?

  description String?

  createdAt   DateTime @default(now())
}


// ===============================
// RELOCATION SITE
// ===============================

model RelocationSite {
  id                    String   @id @default(uuid())
  name                  String

  districtId            String
  district              District @relation(fields: [districtId], references: [id])

  latitude              Float
  longitude             Float

  availableLand         Float

  currentPopulation     Int      @default(0)
  maxPopulation         Int

  housingCapacity       Int
  waterCapacity         Int
  healthcareCapacity    Int
  infrastructureCapacity Int

  roadAccessibility     Float    @default(0)
  employmentAccessibility Float  @default(0)

  hazardRisk            Float    @default(0)

  availableCapacity     Int      @default(0)

  suitabilityScore      Float    @default(0)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  recommendations       Recommendation[]
}


// ===============================
// RECOMMENDATION
// ===============================

model Recommendation {
  id              String         @id @default(uuid())

  habitationId    String
  siteId          String

  site            RelocationSite @relation(fields: [siteId], references: [id])

  rank            Int
  score           Float

  reason          String

  recommendedPopulation Int?

  createdAt       DateTime       @default(now())
}